# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Public URL of this app (used for links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Phase 2) ---
# Project URL and publishable (anon) key: safe for the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured inside Supabase (Authentication → Providers → Google),
# not in this file. Transactional email (SMTP) is configured in Supabase too.
