# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Public URL of this app (fallback for links when the request origin is unknown)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project URL and publishable key (Project Settings → API Keys). Safe for the
# browser: access is enforced by Row Level Security in the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key: SERVER ONLY, bypasses Row Level Security. Not needed until the
# admin portal (Phase 7). Never prefix with NEXT_PUBLIC_ and never commit it.
# SUPABASE_SECRET_KEY=

# Google sign-in and email delivery (SMTP) are configured in the Supabase
# dashboard, not in this file. See README → Authentication setup.
